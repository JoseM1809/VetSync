# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
PUERTO=3000
# memoria | mysql
PERSISTENCIA=memoria
MYSQL_HOST=localhost
MYSQL_PUERTO=3306
MYSQL_USUARIO=vetsync
MYSQL_CONTRASENA=vetsync_local
MYSQL_BASE_DATOS=vetsync
HORAS_ANTICIPACION_RECORDATORIO=24
MINUTOS_INTERVALO_RECORDATORIOS=5
# Token para las rutas de administración (/api/notificaciones). Mínimo 16 caracteres.
# Si se deja vacío, esas rutas quedan cerradas (403).
TOKEN_ADMIN=
